<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>nl.llm</groupId>
    <artifactId>storyteller-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>storyteller-frontend-react</artifactId>
  <name>storyteller-frontend-react</name>
  <packaging>pom</packaging>

  <!-- The React front-end is built and tested here so it participates in the reactor like the
       Java modules. The npm build needs the npm registry and a Node download, so its executions
       are gated to CI (env CI=true). Local and offline builds keep this module as an inert
       pom project, leaving `mvn clean verify` unchanged there.
       Every execution binds to verify, in declaration order, so that lifecycle runs stopping
       before verify skip npm entirely. The release workflow packages with `mvn clean package`
       and would otherwise download Node and run `npm ci` without executing a single check. -->
  <profiles>
    <profile>
      <id>react-frontend</id>
      <activation>
        <property>
          <name>env.CI</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <installDirectory>${project.build.directory}</installDirectory>
              <nodeVersion>v22.12.0</nodeVersion>
            </configuration>
            <executions>
              <execution>
                <id>install-node-and-npm</id>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <phase>verify</phase>
              </execution>
              <execution>
                <id>npm-ci</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <arguments>ci</arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-build</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <arguments>run build</arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-test</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <arguments>test</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
