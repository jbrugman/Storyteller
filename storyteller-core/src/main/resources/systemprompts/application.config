# Set backend.type=managed-llama-server to let Storyteller start llama-server for a local GGUF model.
# Set backend.type=managed-mlx-server to let Storyteller start mlx_vlm.server for a local MLX model.
# Set backend.type=openai-compatible to use a local or remote OpenAI-compatible endpoint (e.g. LM Studio, OpenAI API, or other compatible endpoints).

backend.type=openai-compatible
google.backend=false
backend.http.url=http://localhost:1234/v1/chat/completions
# Optional bearer token for hosted OpenAI-compatible endpoints. Leave blank for local endpoints.
backend.http.apiKey=

backend.llama.command=
backend.llama.modelPath=
backend.llama.port=0
backend.llama.startupTimeoutSeconds=120
backend.llama.arguments=

backend.mlx.command=
backend.mlx.modelPath=
backend.mlx.port=0
backend.mlx.startupTimeoutSeconds=180
backend.mlx.arguments=

# Explicit model names enable the Responses endpoint; blank values use Chat Completions and the backend's default model.
model.chat=
model.validator=

# Optional shared model endpoint for summaries, canonical state, and graph generation.
# Empty values use model.chat and backend.http.*.
memory.http.model=
memory.http.url=
memory.http.apikey=

file.systemPrompt=systemprompts/systemprompt.md
file.rules=systemprompts/rules.md
file.fixedProtagonists=systemprompts/fixed_protagonists.yml
file.fixedProtagonistsContext=systemprompts/fixedprotagonistscontext.md
file.summarySystemPrompt=systemprompts/summarysystemprompt.md
file.summaryContext=systemprompts/summarycontext.md
file.summary=memory/summary.md
file.recentSummarySystemPrompt=systemprompts/recentsummarysystemprompt.md
file.recentSummaryContext=systemprompts/recentsummarycontext.md
file.recentSummary=memory/recent-summary.md
file.canonicalStateSystemPrompt=systemprompts/canonicalstatesystemprompt.md
file.canonicalStateContext=systemprompts/canonicalstatecontext.md
file.validationSystemPrompt=systemprompts/validationsystemprompt.md
file.validationRequestTemplate=systemprompts/validationrequesttemplate.md
file.turnViolationSingleTemplate=systemprompts/turnviolationsingletemplate.md
file.turnViolationPartyTemplate=systemprompts/turnviolationpartytemplate.md
file.canonicalState=memory/canonical-state.yaml
file.history=memory/history.json
file.legacyHistory=memory/history.md
file.turnState=memory/turn-state.json
file.knowledgeGraph=memory/knowledge-graph.json
database.path=memory/storyteller-api

chat.maxRecentTurns=2
# turns sends chat.maxRecentTurns recent turns. rolling sends as many recent turns as fit in the
# model's context window; the system prompt, derived memory, and knowledge-graph facts always stay.
chat.contextMode=turns
# Total context window of the model in tokens. 0 means unknown, and rolling then behaves like turns.
chat.contextWindow=0
# Tokens kept free for the model's reply while assembling a rolling context. A higher chat.maxTokens
# or session response limit wins over this reserve.
chat.responseReserveTokens=1024
recentSummary.maxRecentTurns=12
chat.temperature=0.6
chat.topK=40
chat.topP=0.9
chat.minP=0.05
chat.repeatPenalty=1.1

summary.batchMessages=10
recentSummary.batchMessages=6
canonicalState.batchMessages=2
graph.turnBased.batchTurns=3
graph.enabled=true
summary.temperature=0.2
summary.topP=0.9

game.turnBasedModeEnabled=false
game.turnPenaltySingleLowHp=5
game.turnPenaltySingleHighHp=10

validation.temperature=0.0
validation.topP=0.1
validation.enabled=true
# Streaming requires validation.enabled=false. These defaults can be overridden in session settings.
streaming.enabled=false
# auto uses OpenAI-compatible JSON Schema output for validation and retries as text when unsupported.
# Set text for legacy endpoints, or json-schema to require constrained validator output.
validation.outputMode=auto

timeout.chatSeconds=350
timeout.summarySeconds=350
timeout.validationSeconds=180

resilience.chat.failureThreshold=3
resilience.chat.cooldownSeconds=20
resilience.validation.failureThreshold=2
resilience.validation.cooldownSeconds=15
resilience.background.failureThreshold=2
resilience.background.cooldownSeconds=60

response.hideReasoningBlocks=true
# Log output and thinking-token counts returned by the model server for every completed request.
logging.modelUsage=false
response.validationFailClosedMessage=The story drifted away from the rules. Try again with a cleaner prompt.

command.continueStory=(continue the story)
command.resetStory=(reset your behavior; strictly follow the system prompt, fixed protagonists, and rules from now on)
ui.bannerStart=Storyteller started.
ui.commandHelp=Use /exit or /quit to leave.\n- Use /image <instruction> to send the image currently copied to the clipboard.\n- Use /export for markdown export, /export -intro for italicized prompts, /export -clean for story-only output, /export -all for full chronological prompt and story export, or /export -zip for a portable session ZIP that can be imported by the web interface.\n- Use /graph to inspect the knowledge graph, /graph -generate to create an empty graph file, /graph -fill to fill it from fixed protagonists using the model, or /graph -reset to remove only turn-based graph data.\n- Use /benchmark [-<model>] to run the isolated fixed benchmark scenario with the requested or already loaded backend model.
ui.shortcutContinueHint=Press Ctrl-G to send '(continue the story)'.
ui.shortcutResetHint=Press Ctrl-W to send a reset instruction if the model starts drifting.
ui.shortcutUndoHint=Press Ctrl-U to remove the last turn, send a reset instruction, and restore your last prompt for editing.
ui.shortcutLastTurnHint=Press Ctrl-L to show the last persisted prompt and reply without sending anything to the model.
ui.resetSent=Reset instruction sent. Re-checking the active rules now.
ui.undoSent=Undo command sent. Removing the last turn and sending a reset instruction now.
ui.noStoryTurnToUndo=No story turn available to undo.
ui.undoRestored=The removed prompt has been restored in the input buffer for editing.
ui.noLastTurn=No persisted story turn available yet.
ui.lastTurnTemplate=Last persisted turn\n\nUser:\n%s\n\nAssistant:\n%s
ui.macHint=On macOS, use the Control (Ctrl) key, not Command (Cmd), for the shortcuts shown above.
ui.errorBackendRequest=Model backend request error
ui.errorProcessHistory=Error processing history or response

# Use MySQL instead of embedded H2. Supply mysql.password in the local application.config.
mysql=false
mysql.url=jdbc:mysql://localhost:3306/storyteller
mysql.username=storyteller
mysql.password=

# Optional Base64-encoded 32-byte key for database content only. See README for an example.
# Keep your own generated key in the local application.config; empty leaves encryption disabled.
database.encryption.key=
