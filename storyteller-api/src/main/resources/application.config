api.host=0.0.0.0
api.port=7090
api.database.path=memory/storyteller-api
api.database.username=sa
api.database.password=
api.sessionTimeoutMinutes=60
api.tls.enabled=true
api.tls.port=7443
api.tls.directory=memory/tls
# Additional DNS names or IP addresses, separated by commas. Localhost, the machine hostname, and current local IP addresses are added automatically.
api.tls.subjectAlternativeNames=

# Use MySQL instead of embedded H2. Supply mysql.password in the local application.config.
mysql=false
mysql.url=jdbc:mysql://localhost:3306/storyteller
mysql.username=storyteller
mysql.password=

# Optional Base64-encoded 32-byte key for database content only. See README for an example.
# Keep your own generated key in the local application.config; empty leaves encryption disabled.
database.encryption.key=
