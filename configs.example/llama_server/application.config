backend.type=managed-llama-server
backend.llama.command=llama-server
backend.llama.modelPath=./models/Gemma4-26B-A4B-QAT.gguf
backend.llama.port=0
backend.llama.startupTimeoutSeconds=120

# --n-cpu-moe is intentionally omitted: active expert count is model metadata, while that flag keeps MoE layers on the CPU.
backend.llama.arguments=--ctx-size 32768 --ctx-checkpoints 32 --parallel 3 --threads 6 --threads-batch 6 --batch-size 1024 --ubatch-size 512 --kv-offload --cache-type-k q8_0 --cache-type-v q8_0 --flash-attn on --reasoning off

# The launcher allocates this much context with --ctx-size, so Storyteller knows the size it may fill.
# chat.contextMode=turns keeps sending chat.maxRecentTurns recent turns; set it to rolling to fill that window
# with as many recent turns as still fit, which is what smaller models usually need.
chat.contextWindow=32768
chat.contextMode=turns
