backend.type=managed-mlx-server

backend.mlx.command=python3
backend.mlx.modelPath=./model/gemma-4-26b-a4b-it-4bit
backend.mlx.port=0
backend.mlx.startupTimeoutSeconds=180
backend.mlx.arguments=-m mlx_vlm.server --max-kv-size 32768 --max-tokens 32768

# The launcher allocates this much context with --max-kv-size, so Storyteller knows the size it may fill.
# chat.contextMode=turns keeps sending chat.maxRecentTurns recent turns; set it to rolling to fill that window
# with as many recent turns as still fit, which is what smaller models usually need.
chat.contextWindow=32768
chat.contextMode=turns
